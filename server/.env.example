# Salin ke .env (TIDAK masuk git). Nilai rahasia dibuat acak, mis. `openssl rand -base64 32`.
PG_PASSWORD=
# Kunci yang wajib dikirim /api/proxy Vercel lewat header x-api-key (sama dengan env API_KEY di Vercel)
API_KEY=
# URL deployment GAS khusus sinkron (BUKAN deployment lama produksi) + secret = SYNC_SECRET di backend-prod/Secret.gs
GAS_SYNC_URL=
SYNC_SECRET=
# 0 = sinkron ke spreadsheet mati (uji coba). Nyalakan (1) tepat saat cutover.
SYNC_AKTIF=0
